# Copy this file to .env and fill it in:   cp .env.example .env
# Everything except the secrets can also be changed later in the web UI (Settings).

# --- Basics -------------------------------------------------------------------------------
# Your timezone (IANA name). Used as the default display timezone.
TZ=America/New_York

# The URL you use to reach Pitwall. Used for links in emails and the calendar feed.
# Direct port:   http://mh-flex-01:8080
# Behind proxy:  https://pitwall.example.com
PITWALL_BASE_URL=http://mh-flex-01:8080

# Host port for the web UI (container listens on 8080).
PITWALL_PORT=8080
# 0.0.0.0 = reachable from your network; 127.0.0.1 = only from this machine (same-host proxy).
PITWALL_BIND=0.0.0.0

# --- Secrets (never logged, never shown in full in the UI) -------------------------------
# Password for the "admin" account, used the first time Pitwall starts. After that, passwords
# live in Pitwall's database: change them in the web UI (Account) or with
#   sudo docker compose exec pitwall python -m pitwall set-password admin
PITWALL_ADMIN_PASSWORD=change-me-to-something-long

# Calendar-feed token for the admin account (each user has their own, see Account in the UI).
# Generate one with:  openssl rand -hex 24
PITWALL_ICS_TOKEN=

# Optional: key used to sign login cookies. If empty, one is generated in ./data/.secret_key.
PITWALL_SECRET_KEY=

# --- Notifications (optional) -------------------------------------------------------------
# Easiest: add email/webhook channels in the web UI (Settings → Notification channels).
# Apprise URLs listed here are used in addition to those (comma-separated). Examples:
#   Gmail (app password):  mailto://you:abcdefghijklmnop@gmail.com
#   Microsoft 365:         mailtos://you%40contoso.com:PASSWORD@contoso.com?smtp=smtp.office365.com&mode=starttls
#   ntfy:                  ntfy://your-secret-topic
#   Generic JSON webhook:  jsons://example.com/hook
APPRISE_URLS_EMAIL=
APPRISE_URLS_WEBHOOK=

# --- History / logging -------------------------------------------------------------------
# First season to download for track stats and trivia.
PITWALL_BACKFILL_START_YEAR=2000

# DEBUG, INFO, WARNING or ERROR
PITWALL_LOG_LEVEL=INFO

# --- Reverse proxy (optional) ------------------------------------------------------------
# Set to true when Pitwall is served over HTTPS (makes the login cookie HTTPS-only).
PITWALL_SECURE_COOKIES=false
# Address(es) of your Cloudflare Tunnel connector (cloudflared) or reverse proxy, comma
# separated; ranges like 192.168.1.0/24 work too. Requests from these addresses may say who the
# real visitor is (X-Forwarded-For), which login rate limiting relies on. Never use "*" if
# Pitwall's port is reachable by anything other than that proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Run the container as this user/group (must own ./data). `id -u` / `id -g` show yours.
PUID=1000
PGID=1000
