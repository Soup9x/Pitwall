# Copy this file to .env and fill it in:   cp .env.example .env
# Everything except the secrets can also be changed later in the web UI (Settings).

# --- Basics -------------------------------------------------------------------------------
# Your timezone (IANA name). Used as the default display timezone.
TZ=America/New_York

# The URL you use to reach Pitwall. Used for links in emails and the calendar feed.
# Direct port:   http://mh-flex-01:8080
# Behind proxy:  https://pitwall.example.com
PITWALL_BASE_URL=http://mh-flex-01:8080

# Host port for the web UI (container listens on 8080).
PITWALL_PORT=8080

# --- Secrets (never logged, never shown in full in the UI) -------------------------------
# Password for the web UI. Pick something long.
PITWALL_ADMIN_PASSWORD=change-me-to-something-long

# Secret token for the calendar feed URL (Google Calendar needs a URL without login).
# Generate one with:  openssl rand -hex 24
PITWALL_ICS_TOKEN=

# Optional: key used to sign login cookies. If empty, one is generated in ./data/.secret_key.
PITWALL_SECRET_KEY=

# --- Notifications (Apprise URLs; separate several with commas) --------------------------
# Email. Gmail with an app password (sends to yourself):
#   mailto://you:abcdefghijklmnop@gmail.com
# Microsoft 365 (replace contoso.com with your domain):
#   mailtos://you%40contoso.com:PASSWORD@contoso.com?smtp=smtp.office365.com&mode=starttls
# Send to a different address by adding  ?to=someone%40example.com  (or &to=... if there's a ?)
APPRISE_URLS_EMAIL=

# Webhooks. Examples:
#   ntfy:    ntfy://your-secret-topic   (self-hosted: ntfys://ntfy.example.com/topic)
#   Discord: discord://WEBHOOK_ID/WEBHOOK_TOKEN
#   Generic JSON (receives {"type", "title", "text", "url", "data"}):  jsons://example.com/hook
APPRISE_URLS_WEBHOOK=

# --- History / logging -------------------------------------------------------------------
# First season to download for track stats and trivia.
PITWALL_BACKFILL_START_YEAR=2000

# DEBUG, INFO, WARNING or ERROR
PITWALL_LOG_LEVEL=INFO

# --- Reverse proxy (optional) ------------------------------------------------------------
# Set to true when Pitwall is served over HTTPS (makes the login cookie HTTPS-only).
PITWALL_SECURE_COOKIES=false
# IPs allowed to set X-Forwarded-For/Proto (your proxy). "*" trusts everyone, which is only OK
# when port 8080 is not reachable from anything except the proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Run the container as this user/group (must own ./data). `id -u` / `id -g` show yours.
PUID=1000
PGID=1000
